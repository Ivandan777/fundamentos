//11.	Hacer un programa para calcular el MCD
//(máximo común divisor) de dos números enteros, 
//usando el algoritmo de Euclides.
#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    int a, b, residuo;
    cout << "Ingrese el numero entero mayor : ";
    cin >> a;
    cout << "Ingrese el numero entero menor: ";
    cin >> b;
    if (a < 0) a = abs(a);
    if (b < 0) b = abs(b);
    while (b != 0)
    {
        residuo = a % b;
        a = b;
        b = residuo;
    }
    cout << "El Maximo Comun Divisor (MCD) es: " << a << endl;
    return 0;
}
