//9.	Calcular la siguiente serie:
//		S= X/1! - X^2/2! + X^3/3! - ........(+/-)X^n/n!

#include <iostream> 
#include <cmath>
using namespace std; 
int main()
{
    float x,suma = 0,fact = 1;
    int i, n;
    cout<< "introduce numerador (x): ";
    cin>> x; 
    cout <<"introduce factorial denomiador, indice de x y limite de la serie: ";
    cin>> n; 
    for(i=1;i<=n;i++)
    {
        fact = fact * i;
        suma = suma + (pow(-1,i) * (-(pow (x,i) / fact)));
    }
    cout<< "=" << suma;
  return 0;
}
