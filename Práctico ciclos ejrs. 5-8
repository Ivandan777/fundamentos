5.	Calcular el producto de los primeros N números enteros.
	P= 1x2x3x........xN
*******************************************************************************/
#include <iostream>
using namespace std; 
int main()
{
    int n,i,mult=1;
    cout<< "introduce un numero entero: ";
    cin>>n;
    for (i=1;i<=n;i++)
    {
        mult= mult*i;
        
    }
    cout<<"el producto desde 1 hasta "<< n <<" es "<<mult;
    return 0;
}
