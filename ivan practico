#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    int n;
    cout << "ingrese un numero entero: ";
    cin >> n;
    int numtemp = abs(n), invertido = 0, digito;
    while (numtemp > 0) 
    {
        digito = numtemp % 10;
        invertido = (invertido * 10) + digito;
        numtemp /= 10;
     }
    if (abs(n) = invertido)
       {
          cout << "el numero entero es capìcuo";
       }
    else
       {
        cout << "el numero entereo no es capìcuo";
       }
        
    return 0;
}
