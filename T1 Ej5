#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main() {
    double x1, y1, x2, y2, x3, y3;
    double D, centroX, centroY, radio;

    // Pedir los tres puntos
    cout << "Ingrese x1 y y1: ";
    cin >> x1 >> y1;

    cout << "Ingrese x2 y y2: ";
    cin >> x2 >> y2;

    cout << "Ingrese x3 y y3: ";
    cin >> x3 >> y3;

    // Calcular D
    D = 2 * (x1 * (y2 - y3) +
             x2 * (y3 - y1) +
             x3 * (y1 - y2));

    // Verificar si los puntos están alineados
    if (D == 0) {
        cout << "Los tres puntos estan alineados." << endl;
        cout << "No se puede formar una circunferencia." << endl;
    } 
    else {
        // Calcular coordenada X del centro
        centroX = (
            (x1 * x1 + y1 * y1) * (y2 - y3) +
            (x2 * x2 + y2 * y2) * (y3 - y1) +
            (x3 * x3 + y3 * y3) * (y1 - y2)
        ) / D;

        // Calcular coordenada Y del centro
        centroY = (
            (x1 * x1 + y1 * y1) * (x3 - x2) +
            (x2 * x2 + y2 * y2) * (x1 - x3) +
            (x3 * x3 + y3 * y3) * (x2 - x1)
        ) / D;

        // Calcular el radio
        radio = sqrt(
            pow(centroX - x1, 2) +
            pow(centroY - y1, 2)
        );

        cout << fixed << setprecision(2);

        cout << "\nCentro de la circunferencia: ("
             << centroX << ", " << centroY << ")" << endl;

        cout << "Radio: " << radio << endl;
    }

    return 0;
}
